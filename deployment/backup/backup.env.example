# Install as /etc/jamurtani/backup.env, owned by root, mode 0600.
APP_ROOT=/srv/jamurtani
PHP_BIN=/usr/bin/php
DB_BACKUP_CNF=/etc/jamurtani/mariadb-backup.cnf
DB_DATABASE=dlingo_jamur
RESTIC_REPOSITORY=sftp:backup@__OFFSITE_HOST__:/srv/backups/jamurtani
RESTIC_PASSWORD_FILE=/etc/jamurtani/restic-password
BACKUP_HOST=jamurtani-production

# Must exceed the PHP-FPM pool request_terminate_timeout (60 seconds).
BACKUP_DRAIN_SECONDS=65
