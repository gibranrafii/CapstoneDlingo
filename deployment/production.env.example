# Template only. Install a private .env; never commit real values.
APP_NAME="JamurTani Dlingo"
APP_ENV=production
APP_DEBUG=false
APP_KEY=__GENERATE_ONCE_AND_KEEP_PRIVATE__
APP_URL=https://__DOMAIN__
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=dlingo_jamur
DB_USERNAME=jamurtani_runtime
DB_PASSWORD=__PRIVATE_RUNTIME_PASSWORD__
DB_URL=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_PATH=/
CACHE_STORE=database
CACHE_PREFIX=jamurtani_production
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
BCRYPT_ROUNDS=12
# Direct Nginx -> PHP-FPM needs no trusted proxy. Add only actual proxy IPs/CIDRs.
TRUSTED_PROXIES=
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=__SMTP_HOST__
MAIL_PORT=465
MAIL_USERNAME=__SMTP_USERNAME__
MAIL_PASSWORD=__PRIVATE_SMTP_PASSWORD__
MAIL_FROM_ADDRESS=__VERIFIED_SENDER_ADDRESS__
MAIL_FROM_NAME="JamurTani"
